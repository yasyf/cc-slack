#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import sys
from collections.abc import Iterator, Sequence
from dataclasses import dataclass
from pathlib import Path

SLACK_TOKEN = re.compile(r"<[^<>\s][^<>]*>")
LINK_LABEL = re.compile(r"<(?:https?://|mailto:)[^<>|\s]*\|([^<>]*)>")
NESTED_LINK = re.compile(r"<(?:https?://|mailto:)[^<>|\s]*\|[^<>]*?(?=\s*<)")
NESTED_FIX = "a link's words cannot hold another link or mention, and Slack draws both broken; end this link's words, then put the inner one after it"
CODE_SPAN = re.compile(r"`[^`\n]+`")
EMPHASIS = re.compile(r"(?<!\w)([*_~]+)(?=\S)(.*?\S)\1(?!\w)")
SENTENCE_END = re.compile(r"[.!?](?=\s|$)")
LIST_ITEM = re.compile(r"^\s*(?:[-*•◦]|\d+[.)])\s")
LEADING_THE = re.compile(r"^the\s+", re.IGNORECASE)
MAX_SENTENCES = 3
UNFURLING_URLS = (
    r"[\w-]+\.sentry\.io/issues/",
    r"sentry\.io/organizations/[\w-]+/issues/",
    r"app\.datadoghq\.com/(?:monitors|incidents|event)/",
)


@dataclass(frozen=True)
class Rule:
    kind: str
    pattern: re.Pattern[str]
    fix: str
    reads_code: bool = True
    reads_labels: bool = False
    passes_his_words: bool = False


RULES = (
    Rule(
        "commit-sha",
        re.compile(r"(?<![\w.])(?<!\w-)(?=[0-9a-f]*[0-9])(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\b(?!\.\w|-\w)"),
        "link the commit as <https://github.com/<org>/<repo>/commit/<sha>|<7-char sha>>, or name the release or PR instead",
    ),
    Rule(
        "ruling-id",
        re.compile(r"\b[GRL]\d{2,}\b"),
        "inbox, ruling, and cursor ids mean nothing to the reader; say what was decided or done",
    ),
    Rule(
        "codename",
        re.compile(r"(?<![\w'’./@#&+-])(?<![Dd]irection )(?<![Oo]ption )(?<![Pp]lan )(?<![Pp]hase )(?<![Ss]tep )[B-HJ-Z](?![\w'’/&+#-]|\.\w)"),
        "a one-letter name for work in flight means nothing to the reader; name the thing, such as the new release pipeline",
        reads_code=False,
        reads_labels=True,
    ),
    Rule(
        "drive-term",
        re.compile(r"(?<![\w./-])(?i:(?:lanes?|desks?|parity|fenc(?:e|ed|es|ing)|stack-enqueue|the drive)\b)(?![-/]\w|\.\w)|\b(?:merge-)?walker\b|(?<![\w./:-])[oj]\d{2,}(?![\w/-]|\.\w)"),
        "say what happens to the reader's work instead, such as the deploy that runs after each merge or the freeze on api",
        reads_code=False,
        reads_labels=True,
        passes_his_words=True,
    ),
    Rule(
        "internal-id",
        re.compile(r"\b(?:brw|run|exec|ctx)_[A-Za-z0-9]+"),
        "link the run or browser page, or describe it in the reader's terms",
        reads_labels=True,
    ),
    Rule(
        "zone-label",
        re.compile(r"\b(?:UTC|GMT|PST|PDT|PT)\b|\b\d{1,2}:\d{2}(?::\d{2})?Z\b"),
        "state the time in the team's local time with no zone label, such as 5:25pm",
        reads_labels=True,
    ),
    Rule(
        "ulid",
        re.compile(r"\b[0-9A-HJKMNP-TV-Z]{26}\b"),
        "pod and object ULIDs mean nothing to the reader; link the dashboard or describe the object",
        reads_labels=True,
    ),
    Rule(
        "bare-number",
        re.compile(r"(?<![\w&])#\d+\b|\b(?:PR|pull|build|deploy|release)\s+#?\d{3,}\b(?!\.\d)", re.IGNORECASE),
        "link it under words saying what it is, as <url|the fix that adds the update button>",
        reads_code=False,
    ),
    Rule(
        "bare-url",
        re.compile(rf"https?://(?!{'|'.join(UNFURLING_URLS)})\S+"),
        "wrap it as <url|short label>; Slack draws a Slack message under words that name it, and only a Sentry issue or Datadog monitor, incident, or event link stays bare so Slack unfurls it",
    ),
    Rule(
        "plain-name",
        re.compile(r"(?i:\b(?:hi|hey|hello|thanks|thank you)\b),?[ \t]+[A-Z][a-z]+\b"),
        "address the person as a <@U…> mention, which Slack renders as their @handle; look the id up with slack_users",
    ),
    Rule(
        "option-reference",
        re.compile(
            r"(?i)\b(?:options?|choices?)\s+(?:#?[1-9]|one|two|three|four)\b(?:\s*(?:,|and|or|&)\s*(?:#?[1-9]|one|two|three|four)\b)*"
            r"|\b(?:first|second|third|fourth|last|previous|next|above|top|bottom|1st|2nd|3rd|4th)\s+(?:options?|choices?)\b|\b(?:options?|choices?)\s+(?:above|below)\b"
            r"|\b(?:same\s+as|as\s+in|as|like|unlike|than|pick|choose|prefer)\s+[#(]?[1-9]\)?"
            r"(?=[ \t]*$|\s*[^\w\s%.,]|[.,](?:\D|$)|\s+(?:and|but|or|nor|plus|with|without|except|only|then|so|yet|in|on|at|to|for|from|by|is|are|was|does|did|has|adds|keeps|would|will|above|below|which|that|though|instead|minus|too|also)\b)"
        ),
        "a card draws its recommended option first and renumbers the rest; name the option in its own words, never by number or position",
        reads_code=False,
        reads_labels=True,
    ),
    Rule(
        "bare-identifier",
        re.compile(r"(?<![\w`])[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+(?![\w`])"),
        "wrap identifiers such as env, secret, and setting names in backticks",
        reads_code=False,
        reads_labels=True,
    ),
    Rule(
        "unproven",
        re.compile(
            r"(?i)^[ \t]*(?:(?:[-*•◦]|\d+[.)])[ \t]+)?`?(?P<token>(?:still[ \t]+)?"
            r"(?:not[ \t]+(?:yet[ \t]+)?(?:proven|proved|verified|confirmed|tested|seen[ \t]+(?:it[ \t]+)?working)|un(?:proven|verified|confirmed|tested))\b)"
        ),
        "a post never lists what is not proven yet, under any label; delete the paragraph and put a job on the unknown, so the reader gets its result or nothing",
    ),
    Rule(
        "nothing-new",
        re.compile(
            r"(?i)^[ \t]*(?:(?:[-*•◦]|\d+[.)])[ \t]+)?(?P<token>(?:no[ \t]+(?:changes?|news|updates?|progress)|nothing[ \t]+(?:new|(?:has[ \t]+)?changed|to[ \t]+report)"
            r"|(?:still[ \t]+)?(?:the[ \t]+)?same[ \t]+as[ \t]+(?:before|last[ \t]+time))(?:[ \t]+(?:yet|so[ \t]+far|here|since|from)\b(?:[ \t]+(?:[^\s.!?;,:—–]|(?<=\d):(?=\d))+){0,3})?)[ \t]*[.!]?[ \t]*$"
        ),
        "this line reports no change, which tells the reader nothing; post nothing, or react :+1: to a message that needs no answer",
    ),
)


@dataclass(frozen=True)
class Finding:
    line: int
    column: int
    kind: str
    token: str
    fix: str

    def __str__(self) -> str:
        return f"{self.line}:{self.column} {self.kind} {self.token!r}: {self.fix}"


def mask_slack_tokens(line: str, labels: bool = False) -> str:
    while (masked := SLACK_TOKEN.sub(lambda match: masked_token(match.group(), labels), line)) != line:
        line = masked
    return line


def masked_token(token: str, labels: bool) -> str:
    if not (labels and (link := LINK_LABEL.fullmatch(token))):
        return " " * len(token)
    return f"{' ' * link.start(1)}{link[1]}{' ' * (len(token) - link.end(1))}"


def mask_code(line: str) -> str:
    return CODE_SPAN.sub(lambda match: " " * len(match.group()), line)


def mask_emphasis(line: str) -> str:
    while (unmarked := EMPHASIS.sub(lambda match: f"{' ' * len(match[1])}{match[2]}{' ' * len(match[1])}", line)) != line:
        line = unmarked
    return line


def plain(line: str, labels: bool = False) -> str:
    return mask_emphasis(mask_slack_tokens(line, labels))


def check(text: str, asked: Sequence[str] = ()) -> list[Finding]:
    findings = walls(text) + nested_links(text)
    for number, (line, fenced) in enumerate(fenced_lines(text), start=1):
        masked = {labels: plain(line, labels) for labels in (False, True)}
        for rule in RULES:
            if fenced and not rule.reads_code:
                continue
            span = "token" if "token" in rule.pattern.groupindex else 0
            read = masked[rule.reads_labels]
            for match in rule.pattern.finditer(read if rule.reads_code else mask_code(read)):
                token = line[match.start(span) : match.end(span)]
                if not (rule.passes_his_words and his_word(token, asked)):
                    findings.append(Finding(number, match.start(span) + 1, rule.kind, token, rule.fix))
    return sorted(findings, key=lambda finding: (finding.line, finding.column))


def his_word(token: str, asked: Sequence[str]) -> bool:
    word = re.compile(rf"(?<!\w){re.escape(LEADING_THE.sub('', token))}s?(?!\w)", re.IGNORECASE)
    return any(word.search(message) for message in asked)


def walls(text: str) -> list[Finding]:
    findings = []
    start, sentences = 0, 0
    for number, (line, fenced) in enumerate([*fenced_lines(text), ("", False)], start=1):
        if fenced or not line.strip() or LIST_ITEM.match(line):
            if sentences > MAX_SENTENCES:
                opening = " ".join(text.splitlines()[start - 1].split()[:6])
                findings.append(Finding(start, 1, "wall-of-text", opening, f"{sentences} sentences in one paragraph; keep each paragraph to {MAX_SENTENCES} sentences or fewer, and put steps and settings in a bulleted list"))
            start, sentences = 0, 0
            continue
        start = start or number
        sentences += len(SENTENCE_END.findall(mask_code(plain(line))))
    return findings


def nested_links(text: str) -> list[Finding]:
    return [
        Finding(number, match.start() + 1, "nested-link", line[match.start() : match.end()], NESTED_FIX)
        for number, (line, fenced) in enumerate(fenced_lines(text), start=1)
        if not fenced
        for match in NESTED_LINK.finditer(mask_code(line))
    ]


def fenced_lines(text: str) -> Iterator[tuple[str, bool]]:
    fenced = False
    for line in text.splitlines():
        fences = line.count("```")
        yield line, fenced or fences > 0
        fenced ^= fences % 2 == 1


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Flag internal ids, raw shas, unlinked references, links nested in another link's words, options named by number or position, plain-name greetings, unformatted identifiers, paragraphs listing what is not proven, lines reporting no change, and walls of text in a Slack post, reading the words of each link as the reader sees them."
    )
    parser.add_argument("path", nargs="?", default="-", help="post text file, or - for stdin")
    parser.add_argument(
        "--asked",
        action="append",
        default=[],
        help="a message of the reader's that the post answers, word for word; repeat for each. A multi-agent term the reader used there, such as the drive, passes",
    )
    args = parser.parse_args()
    text = sys.stdin.read() if args.path == "-" else Path(args.path).read_text()
    findings = check(text, args.asked)
    for finding in findings:
        print(finding)
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
